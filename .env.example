# ---------------------------------------------------------------
# IT Support Ticket MCP Server - configuration template
# Copy to .env and adjust:   cp .env.example .env
# ---------------------------------------------------------------

# --- Server ---
SERVER_NAME=IT Support Ticket MCP Server
HOST=0.0.0.0
PORT=8989
MCP_PATH=/mcp

# --- Database (SQLite via SQLModel) ---
DATABASE_URL=sqlite:///./data/tickets.db
# Insert sample tickets on first start when the DB is empty
SEED_DATA=true

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_FILE=ticket-mcp.log
# Rotate after 1 MB, keep 5 backups
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5
